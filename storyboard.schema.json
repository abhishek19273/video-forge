{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://video-forge.local/storyboard.schema.json",
  "title": "Video Forge storyboard",
  "description": "A declarative lesson: scenes, narration, on-screen visuals and timing hints.",
  "type": "object",
  "required": [
    "title",
    "scenes"
  ],
  "additionalProperties": true,
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "theme": {
      "enum": [
        "paper",
        "midnight"
      ],
      "default": "paper"
    },
    "fps": {
      "type": "integer",
      "minimum": 24,
      "maximum": 60,
      "default": 30
    },
    "resolution": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 480
      },
      "minItems": 2,
      "maxItems": 2,
      "default": [
        1920,
        1080
      ]
    },
    "voice": {
      "type": "string",
      "description": "Profile id (warm-female) or engine:voice (edge:en-US-AndrewMultilingualNeural)."
    },
    "speed": {
      "type": "number",
      "minimum": 0.6,
      "maximum": 1.6,
      "default": 1.0
    },
    "captions": {
      "type": "boolean",
      "default": true
    },
    "transition": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string"
            },
            "duration": {
              "type": "number",
              "minimum": 0,
              "maximum": 2
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "brand": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "handle": {
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false
    },
    "music": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            },
            "volume": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "required": [
            "path"
          ],
          "additionalProperties": false
        }
      ]
    },
    "defaults": {
      "type": "object",
      "additionalProperties": true
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/scene"
      }
    }
  },
  "$defs": {
    "tone": {
      "enum": [
        "light",
        "dark",
        "accent"
      ]
    },
    "backdrop": {
      "enum": [
        "plain",
        "grid",
        "glow",
        "sunset",
        "aurora",
        "none"
      ]
    },
    "transition": {
      "oneOf": [
        {
          "enum": [
            "fade",
            "slide-left",
            "slide-right",
            "slide-up",
            "wipe",
            "wipe-up",
            "clock",
            "flip",
            "none"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string"
            },
            "duration": {
              "type": "number",
              "minimum": 0,
              "maximum": 2
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        }
      ]
    },
    "scene": {
      "type": "object",
      "required": [
        "type"
      ],
      "additionalProperties": true,
      "properties": {
        "type": {
          "enum": [
            "title",
            "chapter",
            "statement",
            "bullets",
            "steps",
            "compare",
            "stat",
            "chart",
            "diagram",
            "timeline",
            "quote",
            "image",
            "code",
            "recap",
            "outro",
            "map",
            "flight",
            "portrait",
            "evidence"
          ]
        },
        "id": {
          "type": "string"
        },
        "narration": {
          "type": "string"
        },
        "tts_text": {
          "type": "string",
          "description": "Override the spoken text while keeping the displayed narration."
        },
        "tone": {
          "$ref": "#/$defs/tone"
        },
        "backdrop": {
          "$ref": "#/$defs/backdrop"
        },
        "chapter": {
          "type": "string"
        },
        "transition": {
          "$ref": "#/$defs/transition"
        },
        "duration": {
          "type": "number",
          "minimum": 1,
          "maximum": 120
        },
        "min_duration": {
          "type": "number",
          "minimum": 1
        },
        "max_duration": {
          "type": "number",
          "minimum": 1,
          "maximum": 180
        },
        "pause_before": {
          "type": "number",
          "minimum": 0,
          "maximum": 5
        },
        "pause_after": {
          "type": "number",
          "minimum": 0,
          "maximum": 5
        },
        "voice": {
          "type": "string"
        },
        "speed": {
          "type": "number",
          "minimum": 0.6,
          "maximum": 1.6
        },
        "captions": {
          "type": "boolean"
        },
        "audio": {
          "type": "string",
          "description": "Pre-recorded narration file, relative to the storyboard."
        },
        "chrome": {
          "type": "boolean"
        },
        "props": {
          "type": "object"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "title"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "title"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "chapter"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "title"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "statement"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "text"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "bullets"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "title",
              "items"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "steps"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "title",
              "steps"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "compare"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "left",
              "right"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "stat"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "value",
              "label"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "chart"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "data"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "diagram"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "nodes"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "timeline"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "events"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "quote"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "text",
              "author"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "image"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "src"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "code"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "code"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "recap"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "items"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "outro"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "title"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "map"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "points"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "flight"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "title"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "portrait"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "name",
              "image"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "evidence"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "items"
            ]
          }
        }
      ]
    }
  }
}